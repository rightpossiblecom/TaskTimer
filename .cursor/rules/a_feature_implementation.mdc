#### **4. Repository Implementation (Offline-First)**
```dart
class [FeatureName]Repository implements I[FeatureName]Repository {
  final Local[FeatureName]Service _localService;
  final [FeatureName]SyncService _syncService;

  @override
  Future<Either<Failure, List<[ModelName]>>> get[Items]({
    required String userId,
  }) async {
    try {
      // ALWAYS fetch from local storage first
      await _localService.initialize();
      final items = await _localService.get[Items]ForUser(userId);
      
      // If no local data, suggest checking sync panel
      if (items.isEmpty) {
        logger.info('📱 No local data found. User should check sync panel for cloud data.');
      }
      
      return Right(items);
    } catch (error) {
      return Leflure('Failed to fetch items: ${error.toString()}'));
    }
  }

  @override
  Future<Either<Failure, [ModelName]>> cretem]({
    required [ModelName] item,
    bool requiresInternet = false, // Specify in feature plan
  }) async {
    try {
      // Check if this create operation requires internet (e.g., AI processing)
      if (requiresInternet) {
        final isConnected = await _connectivityUtil.isConnected();
        if (!isConnected) {
          logger.warning('📱 No internet connection. Create operation requires internet.');
          return Left(NetworkFailure('No internet connection. This feature requires internet access.'));
        }
      }

      // Save to local storage first (for offline-capable creates)
      await _localService.save[Item](item);
      
      // Background sync to cloud (fire and forget) or immediate sync for AI creates
      if (requiresInternet) {
        // Immediate sync for internet-required creates
        final result = await _syncService.upload[Item](item: item);
        return result.fold(
          (failure) => Left(failure),
          (syncedItem) {
            _localService.markAsSynced(item.id);
            return Right(syncedItem);
          },
        );
      } else {
        // Background sync for offline-capable creates
   _sync[Item]ToCloud(item);
        return Right(item);
      }
    } catch (error) {
      return Left(Failure('Failed to create item: ${error.toString()}'));
    }
  }

  @override
  Future<Either<Failure, [ModelName]>> update[Item]({
    required [ModelName] item,
  }) async {
    try {
      // Check network connectivity for updates
      final isConnected = await _connectivityUtil.isConnected();
      if (!isConnected) {
        logger.warning('📱 No internet connection. Update operation blocked (read-only mode).');
        return Left(NetworkFailure('No internet connection. Feature is in read-only mode.'));
      }

      // Update in local storage first
      await _localService.save[Item](item);
      
      // Immediately sync update to cloud (required for updates)
      final result = await _syncService.upload[Item](item: item);
      
      return result.fold(
        (failure) {
          logger.error('❌ Failed to sync update to cloud: ${failure.message}');
          // Revert local changes if cloud sync fails
          // Note: Implement rolllogic based on your needs
          return Left(failure);
        },
        (syncedItem) {
          logger.info('✅ Successfully updated item in both local and cloud: ${item.id}');
          _localService.markAsSynced(item.id);
          return Right(syncedItem);
        },
      );
    } catch (error) {
      return Left(Failure('Failed to update item: ${error.toString()}'));
    }
  }

  @override
  Future<Either<Failure, Unit>> delete[Item]({
    required String userId,
    required String itemId,
  }) async {
    try {
      // Check network connectivity for deletes
      final isConnected = await _connectivityUtil.isConnected();
      if (!isConnected) {
        logger.warning('📱 No internet connection. Delete operation blocked (read-only mode).');
        return Left(NetworkFailure('No internet connection. Feature is in read-only mode.'));
      }

      // Delete from local storage first
      await _localService.delete[Item](itemId);
      
      // Immediately sync deletion to cloud (required for deletes)
      final result = await _syncService.delete[Item](
        itemId: itemId,
        userId: userId,
      );
      
      return result.fold(
        (failure) {
          logger.error('❌ Failed to sync deletion to cloud: ${failure.message}');
          // Note: Consider restoring local item if cloud deletion fails
          return Left(failure);
        },
        (_) {
          logger.info('✅ Successfully deleted item from both local and cloud: $itemId');
          return const Right(unit);
        },
      );
    } catch (error) {
      return Left(Failure('Failed to delete item: ${error.toString()}'));
    }
  }

  /// Background sync to cloud (fire and forget)
  Future<void> _sync[Item]ToCloud([ModelName] item) async {
    try {
      final isConnected = await _connectivityUtil.isConnected();
      if (!isConnected) {
        logger.info('📱 No internet connection, item will sync later: ${item.id}');
        return;
      }

      final result = await _syncService.upload[Item](item: item);
      result.fold(
        (failure) => logger.warning('⚠️ Failed to sync item to cloud: ${failure.message}'),
        (syncedItem) {
          logger.info('✅ Successfully synced item to cloud: ${item.id}');
          _localService.markAsSynced(item.id);
        },
      );
    } catch (e) {
      logger.warning('⚠️ Background sync failed for item ${item.id}: $e');
    }
  }
}
```

