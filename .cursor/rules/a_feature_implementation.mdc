### 6. Presentation Layer - Bloc

Create `lib/features/[feature_name]/presentation/bloc/[feature_name]_bloc.dart`:

```dart
import 'package:hydrated_bloc/hydrated_bloc.dart';
import 'package:learn/features/[feature_name]/domain/i_[feature_name]_repository.dart';
import 'package:learn/features/[feature_name]/presentation/bloc/[feature_name]_event.dart';
import 'package:learn/features/[feature_name]/presentation/bloc/[feature_name]_state.dart';
import 'package:learn/models/[model_name].dart';

class [FeatureName]Bloc extends HydratedBloc<[FeatureName]Event, [FeatureName]State> {
  final I[FeatureName]Repository _[featureName]Repository;

  [FeatureName]Bloc({required I[FeatureName]Repository [featureName]Repository})
    : _[featureName]Repository = [featureName]Repository,
      super(const [FeatureName]State()) {
    on<Get[FeatureName]s>(_get[FeatureName]s);
    on<Get[FeatureName]ById>(_get[FeatureName]ById);
    on<Create[FeatureName]>(_create[FeatureName]);
    on<Update[FeatureName]>(_update[FeatureName]);
    on<Delete[FeatureName]>(_delete[FeatureName]);
  }

  @override
  [FeatureName]State? fromJson(Map<String, dynamic> json) {
    try {
      return [FeatureName]State(
        [featureName]s: (json['[featureName]s'] as List<dynamic>?)
            ?.map((e) => [ModelName].fromJson(e as Map<String, dynamic>))
            .toList() ?? [],
        current[FeatureName]: json['current[FeatureName]'] != null
            ? [ModelName].fromJson(json['current[FeatureName]'] as Map<String, dynamic>)
            : null,
      );
    } catch (_) {
      return null;
    }
  }

  @override
  Map<String, dynamic>? toJson([FeatureName]State state) {
    try {
      return {
        '[featureName]s': state.[featureName]s.map((e) => e.toJson()).toList(),
        'current[FeatureName]': state.current[FeatureName]?.toJson(),
      };
    } catch (_) {
      return null;
    }
  }

  Future<void> _get[FeatureName]s(Get[FeatureName]s event, Emitter<[FeatureName]State> emit) async {
    if (state.[featureName]s.isNotEmpty) {
      emit(state.copyWith(isLoading[FeatureName]s: false));
    } else {
      emit(state.copyWith(isLoading[FeatureName]s: true, load[FeatureName]sError: null));
    }

    final result = await _[featureName]Repository.get[FeatureName]s(userId: event.userId);
    
    await result.fold(
      (failure) async {
        emit(
          state.copyWith(
            isLoading[FeatureName]s: false,
            load[FeatureName]sError: failure.message,
          ),
        );
      },
      ([featureName]s) async {
        emit(state.copyWith([featureName]s: [featureName]s, isLoading[FeatureName]s: false));
      },
    );
  }

  Future<void> _get[FeatureName]ById(Get[FeatureName]ById event, Emitter<[FeatureName]State> emit) async {
    emit(state.copyWith(isLoadingSingle[FeatureName]: true, loadSingle[FeatureName]Error: null));

    final result = await _[featureName]Repository.get[FeatureName]ById(id: event.id);
    
    await result.fold(
      (failure) async {
        emit(
          state.copyWith(
            isLoadingSingle[FeatureName]: false,
            loadSingle[FeatureName]Error: failure.message,
          ),
        );
      },
      ([featureName]) async {
        emit(
          state.           current[FeatureName]: [featureName],
            isLoadingSingle[FeatureName]: false,
          ),
        );
      },
    );
  }

  Futurete[FeatureName](Create[FeatureName] event, Emitter<[FeatureName]State> emit) async {
    emit(state.copyWith(isCreating[FeatureName]: true, create[FeatureName]Error: null));

    final result = await _[featureName]Repository.create[FeatureName]([featureName]: event.[featureName]);
    
    await result.fold(
      (failure) async {
        emit(
          state.copyWith(
            isCreating[FeatureName]: false,
            create[FeatureName]Error: failure.message,
          ),
        );
      },
      (created[FeatureName]) async {
        final updated[FeatureName]s = [...stName]s, created[FeatureName]];
        emit(
          state.copyWith(
            [featureName]s: updated[FeatureName]s,
            isCreating[FeatureNa
            [featureName]JustCreated: true,
          ),
        );
      },
    );
  }

  Future<void> _update[FeatureName](Update[FeatureName] event, Emitter<[FeatureName]State> emit) async {
    emit(state.copyWith(isUpdating[FeatureName]: true, update[FeatureName]Error: null));

    final result = await _[featureName]Repository.update[FeatureName]([featureName]: event.[featureName]);
    
    await result.fold(
      (failure) async {
        emit(
          state.copyWith(
            isUpdating[FeatureName]: false,
            update[FeatureName]Error: failure.message,
          ),
        );
      },
      (updated[FeatureName]) async {
        final updated[FeatureName]s = state.[featureName]s
            .m item.id == updated[FeatureName].id ? updated[FeatureName] : item)
            .toList();
        emit(
          state.copyWith(
            [featureName]s: updated[FeatureName]s,
            current[FeatureName]: updated[FeatureName],
            isUpdating[FeatureName]: false,
            [featureName]JustUpdated: true,
          ),
        );
      },
    );
  }

  Future<void> _delete[FeatureName](Delete[FeatureName] event, Emitter<[FeatureName]State> emit) async {
    emit(state.copyWith(isDeleting[FeatureName]: true, delete[FeatureName]Error: null));

    final result = await _[featureName]Repository.delete[FeatureName](
      userId: event.userId,
      id: event.id,
    );
    
    await result.fold(
      (failure) async {
        emit(
          state.copyWith(
            isDeleting[FeatureName]: false,
            delete[FeatureName]Error: failure.message,
          ),
        );
      },
      (_) async {
        final updated[FeatureName]s = state.[featureName]s
            .where((item) => item.id != event.id)
            .toList();
        emit(
          state.copyWith(
            [featureName]s: updated[FeatureName]s,
            isDeleting[FeatureName]: false,
            [featureName]JustDeleted: true,
          ),
        );
      },
    );
  }
}

// 🚨 CRITICAL: Always await result.fold() and make both callbacks async to prevent BLoC emitter assertion errors

