### 2. Domain Layer (Interface)

Create `lib/features/[feature_name]/domain/i_[feature_name]_repository.dart`:

```dart
import 'package:fpdart/fpdart.dart';
import 'package:learn/core/errors/failures.dart';
import 'package:learn/models/[model_name].dart';

abstract class I[FeatureName]Repository {
  // CRUD Operations using Either pattern
  Future<Either<Failure, List<[ModelName]>>> get[FeatureName]s({
    required String userId,
  });
  
  Future<Either<Failure, [ModelName]?>> get[FeatureName]ById({
    required String id,
  });
  
  Future<Either<Failure, [ModelName]>> create[FeatureName]({
    required [ModelName] [featureName],
  });
  
  Future<Either<Failure, [ModelName]>> update[FeatureName]({
    required [ModelName] [featureName],
  });
  
  Future<Either<Failure, Unit>> delete[FeatureName]({
    required String userId,
    required String id,
  });
}
```

### 3. Data Layer (Repository Implementation)

Create `lib/features/[feature_name]/data/[feature_name]_repository.dart`:

```dart
import 'package:fpdart/fpdart.dart';
import 'package:learn/core/errors/exceptions.dart';
import 'package:learn/core/errors/failures.dart';
import 'package:learn/core/utils/connectivity_util.dart';
import 'package:learn/features/[feature_name]/domain/i_[feature_name]_repository.dart';
import 'package:learn/models/[model_name].dart';
import 'package:supabase_flutter/supabase_flutter.dart';
import 'package:learn/models/supadart_header.dart';
import 'package:learn/core/logger/app_logger.dart';

class [FeatureName]Repository implements I[FeatureName]Repository {
  final SupabaseClient _supabase;
  final ConnectivityUtil _connectivityUtil;

  [FeatureName]Repository({
    required SupabaseClient supabase,
    ConnectivityUtil? connectivityUtil,
  }) : _supabase = supabase,
       _connectivityUtil = connectivityUtil ?? ConnectivityUtil.instance;

  @override
  Future<Either<Failure, List<[ModelName]>>> get[FeatureName]s({
    required String userId,
  }) async {
    try {
      // Check network connectivity
      final isConnected = await _connectivityUtil.isConnected();
      if (!isConnected) {
        return Left(NetworkFailure());
      }

      logger.info('Fetching [feature_name]s for user: $userId');

      final [featureName]s = await _supabase.[table_name]
          .select('*')
          .eq([ModelName].c_userId, userId)
          .withConverter([ModelName].converter);

      logger.debug('Successfully fetched ${[featureName]s.length} [feature_name]s');
      return Right([featureName]s);
    } on PostgrestException catch (error) {
      logger.error('Supabase error fetching [feature_name]s', error: error);
      return Left(ServerFailure('Failed to fetch [feature_name]s: ${error.message}'));
    } on ServerException catch (error) {
      logger.error('Server error fetching [feature_name]s', error: error);
      return Left(ServerFailure(error.message));
    } catch (error, stackTrace) {
      logger.error('Unexpected error fetching [feature_name]s', error: error, stackTrace: stackTrace);
      return Left(Failure('An unexpected error occurred: ${error.toString()}'));
    }
  }

  // Implement other CRUD methods following the same pattern...
}
```

